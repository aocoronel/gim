#!/usr/bin/env bash

dir=$1

if [ -z $dir ]; then
  echo "run: directory not provided"
  exit 1
fi

shift

cwd=$(pwd)

for repo in "$cwd/$dir"*/; do
  [ -d "$repo" ] || continue

  result="$(git -C "$repo" status --porcelain)"
  if [[ -z $result ]]; then
    printf ""
  else
    echo ">> $repo"
    echo "$result"
  fi
done
